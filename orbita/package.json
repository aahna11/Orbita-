{
  "name": "orbita",
  "private": true,
  "scripts": {
    "dev": "npm --prefix server run dev",
    "db:up": "docker compose up -d",
    "db:migrate": "npm --prefix server run migrate",
    "test": "npm --prefix server test",
    "lint": "npm --prefix server run lint",
    "postinstall": "npm --prefix server install",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/src/migrate.js && node server/src/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}